    {
      "id": "IRM-101",
      "title": "item-total rounds the exact sum once; line rounding never feeds aggregation",
      "category": "aggregation",
      "formula": "itemTotal = round2(1.005 + 1.005) = 2.01 (not round0-each = 2)",
      "assumptions": ["R1: aggregation is always from exact line values"],
      "source": {
        "sourceStatus": "design",
        "sourceDocument": null,
        "edition": null,
        "page": null,
        "section": null
      },
      "input": {
        "rounding": [
          {
            "target": "line",
            "selector": { "itemCode": "SYN-1001" },
            "scale": 0,
            "mode": "HALF_UP",
            "sourceStatus": "design"
          },
          {
            "target": "item-total",
            "selector": { "itemCode": "SYN-1001" },
            "scale": 2,
            "mode": "HALF_UP",
            "sourceStatus": "design"
          }
        ],
        "sheets": [
          {
            "sheetId": "S1",
            "lines": [
              {
                "lineId": "L1",
                "rowNo": 1,
                "itemCode": "SYN-1001",
                "kind": "addition",
                "unit": "m2",
                "quantity": {
                  "type": "dimensional",
                  "profile": "LW",
                  "length": "1.005",
                  "width": "1"
                }
              },
              {
                "lineId": "L2",
                "rowNo": 2,
                "itemCode": "SYN-1001",
                "kind": "addition",
                "unit": "m2",
                "quantity": {
                  "type": "dimensional",
                  "profile": "LW",
                  "length": "1.005",
                  "width": "1"
                }
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "lines": { "L1": "1", "L2": "1" },
        "itemTotals": [{ "itemCode": "SYN-1001", "unit": "m2", "qty": "2.01" }],
        "sheetTotals": [
          { "sheetId": "S1", "byItem": [{ "itemCode": "SYN-1001", "unit": "m2", "qty": "2.01" }] }
        ]
      }
    },
